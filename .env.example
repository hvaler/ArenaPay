# Local API settings (process environment).
ARENAPAY_API_PORT=4317
ARENAPAY_API_HOST=127.0.0.1
REPLAY_DIR=./data/matches
# Optional, comma-separated HTTPS endpoints. Used for reads only, after the primary RPC.
ARENAPAY_READ_RPC_URLS=
# Perfil Node público alternativo. Cloudflare utiliza wrangler.jsonc y secretos propios.
ARENAPAY_PUBLIC_MODE=false
ARENAPAY_ALLOWED_ORIGINS=https://example.com
ARENAPAY_DAILY_MATCH_LIMIT=20
ARENAPAY_DEPLOYMENT_FILE=./config/testnet.deployment.json
# npm run deploy:testnet generates an ignored .env.testnet with disposable
# testnet-only ADMIN, REFEREE, DEMO_A and DEMO_B secrets, plus a deployment salt.
# Do not copy user wallet secrets here. Freighter signs user transactions.
# Public contract configuration is in data/testnet/deployment.json.
